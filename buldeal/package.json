{
  "name": "buldeal",
  "private": true,
  "version": "1.0.0",
  "description": "בולדיל – פלטפורמת דילים מהירים לעסקים",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c green,cyan \"node --watch server/index.js\" \"vite\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node server/index.js",
    "seed:demo": "node server/scripts/seedDemo.js",
    "lint": "eslint .",
    "test": "node --test server/tests/*.test.js",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "fflate": "^0.8.3",
    "framer-motion": "^12.23.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.577.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^10.3.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.2.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0",
    "wrangler": "^4.158.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.8.0"
  }
}
