    "helmet": "^7.2.0",
    "lucide-react": "^0.577.0",
    "morgan": "^1.10.0",
    "nanoid": "^5.0.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
